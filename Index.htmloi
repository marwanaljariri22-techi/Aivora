<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Aivora - الذكاء الاصطناعي</title>

<style>

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,Tahoma,sans-serif;
    background:#080616;
    color:white;
    min-height:100vh;
}

body::before{
    content:"";
    position:fixed;
    inset:-30%;
    background:
    radial-gradient(circle at 70% 20%,#6627ff33,transparent 28%),
    radial-gradient(circle at 20% 80%,#a02cff22,transparent 25%);
    pointer-events:none;
}

.container{
    max-width:1150px;
    margin:auto;
    padding:0 22px;
}

/* الشريط العلوي */

.navbar{
    height:78px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    border-bottom:1px solid #ffffff12;
}

.logo{
    font-size:29px;
    font-weight:bold;
}

.logo span{
    color:#9d6cff;
}

.menu{
    display:flex;
    gap:25px;
}

.menu a{
    color:#cfc9e8;
    text-decoration:none;
    font-size:15px;
}

.button{
    border:none;
    border-radius:14px;
    padding:13px 22px;
    background:linear-gradient(135deg,#7b3cff,#b45cff);
    color:white;
    font-weight:bold;
    cursor:pointer;
    box-shadow:0 10px 35px #7b3cff33;
}

/* الرئيسية */

.hero{
    min-height:570px;
    display:grid;
    grid-template-columns:1.05fr .95fr;
    gap:45px;
    align-items:center;
    padding:65px 0;
}

.badge{
    display:inline-block;
    padding:9px 14px;
    border:1px solid #9d6cff55;
    background:#9d6cff12;
    border-radius:30px;
    color:#c9b5ff;
    font-size:13px;
}

h1{
    font-size:58px;
    line-height:1.1;
    margin:22px 0;
}

.gradient{
    background:linear-gradient(90deg,#ffffff,#b994ff);
    -webkit-background-clip:text;
    color:transparent;
}

.description{
    font-size:19px;
    line-height:1.9;
    color:#bcb5d0;
    max-width:600px;
}

.buttons{
    display:flex;
    gap:12px;
    margin-top:28px;
}

.secondary{
    background:#ffffff0b;
    border:1px solid #ffffff18;
    box-shadow:none;
}

/* العنصر البصري */

.visual{
    position:relative;
    min-height:390px;
    display:flex;
    align-items:center;
    justify-content:center;
}

.orb{
    width:280px;
    height:280px;
    border-radius:50%;
    background:
    radial-gradient(circle at 35% 30%,
    #e4cfff,
    #9b5cff 25%,
    #5120bd 58%,
    #170b3c 75%);
    box-shadow:
    0 0 80px #8c4dff88,
    inset 0 0 45px #fff6;
    position:relative;
}

.orb::after{
    content:"AI";
    position:absolute;
    inset:70px;
    border-radius:50%;
    display:grid;
    place-items:center;
    font-size:54px;
    font-weight:900;
    background:#0c0720aa;
    border:1px solid #ffffff33;
    box-shadow:inset 0 0 35px #a66aff55;
}

.float{
    position:absolute;
    background:#120c28dd;
    border:1px solid #ffffff18;
    border-radius:18px;
    padding:15px 18px;
    box-shadow:0 20px 45px #0008;
}

.f1{
    top:30px;
    right:5px;
}

.f2{
    bottom:35px;
    left:0;
}

.f3{
    bottom:0;
    right:25px;
}

/* الأقسام */

section{
    padding:65px 0;
}

.center{
    text-align:center;
}

.section-title{
    font-size:35px;
    margin-bottom:12px;
}

.muted{
    color:#a9a2bc;
}

.cards{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:18px;
    margin-top:30px;
}

.card{
    background:linear-gradient(180deg,#17102c,#0e0920);
    border:1px solid #ffffff12;
    border-radius:22px;
    padding:27px;
    min-height:190px;
}

.icon{
    font-size:30px;
}

.card h3{
    margin:15px 0 8px;
}

.card p{
    color:#a9a2bc;
    line-height:1.7;
}

/* المحادثة */

.chat{
    max-width:780px;
    margin:30px auto;
    background:#100a22;
    border:1px solid #ffffff14;
    border-radius:25px;
    padding:20px;
    box-shadow:0 25px 70px #0008;
}

.message{
    padding:14px 17px;
    border-radius:16px;
    margin:10px 0;
    line-height:1.7;
}

.user{
    background:#6d35db33;
    margin-right:20%;
}

.ai{
    background:#ffffff09;
    margin-left:12%;
}

.chat-input{
    display:flex;
    gap:10px;
    margin-top:16px;
}

.input-box{
    flex:1;
    background:#ffffff08;
    border:1px solid #ffffff12;
    border-radius:14px;
    padding:15px;
    color:#77718c;
}

/* النهاية */

.cta{
    background:linear-gradient(135deg,#1b0d3c,#30116a);
    border:1px solid #ffffff12;
    border-radius:28px;
    padding:45px;
    text-align:center;
}

.cta h2{
    font-size:35px;
    margin-bottom:12px;
}

.footer{
    border-top:1px solid #ffffff10;
    padding:30px 0;
    color:#888198;
    display:flex;
    justify-content:space-between;
}

/* الهاتف */

@media(max-width:800px){

    .menu{
        display:none;
    }

    .hero{
        grid-template-columns:1fr;
        text-align:center;
        padding:45px 0;
    }

    .description{
        margin:auto;
    }

    h1{
        font-size:43px;
    }

    .buttons{
        justify-content:center;
    }

    .cards{
        grid-template-columns:1fr;
    }

    .visual{
        min-height:330px;
    }

    .footer{
        display:block;
        text-align:center;
    }

    .footer div{
        margin:8px;
    }
}

</style>
</head>

<body>

<!-- الشريط العلوي -->

<header class="container navbar">

    <div class="logo">
        Ai<span>vora</span>
    </div>

    <nav class="menu">
        <a href="#">الرئيسية</a>
        <a href="#features">المميزات</a>
        <a href="#chat">المحادثة</a>
        <a href="#about">عن Aivora</a>
    </nav>

    <button class="button"
    onclick="document.getElementById('chat').scrollIntoView({behavior:'smooth'})">
        جرّب الآن
    </button>

</header>


<main class="container">

<!-- الواجهة الرئيسية -->

<section class="hero">

    <div>

        <span class="badge">
            ✦ الجيل الجديد من الذكاء الاصطناعي
        </span>

        <h1>
            ذكاء اصطناعي
            <br>
            <span class="gradient">
                يتحدث لغتك ويفهمك
            </span>
        </h1>

        <p class="description">
            Aivora مساعدك الذكي لإنجاز المهام،
            الإجابة عن الأسئلة، كتابة المحتوى
            وتوليد الأفكار — بتجربة عربية عصرية وسهلة.
        </p>

        <div class="buttons">

            <button class="button"
            onclick="document.getElementById('chat').scrollIntoView({behavior:'smooth'})">
                ابدأ مجانًا ✨
            </button>

            <button class="button secondary"
            onclick="alert('مرحبًا بك في Aivora!')">
                اكتشف Aivora
            </button>

        </div>

    </div>


    <div class="visual">

        <div class="orb"></div>

        <div class="float f1">
            ⚡ سريع وذكي
        </div>

        <div class="float f2">
            🌐 يدعم العربية
        </div>

        <div class="float f3">
            🔒 تجربة آمنة
        </div>

    </div>

</section>


<!-- المميزات -->

<section id="features">

    <div class="center">

        <h2 class="section-title">
            كل ما تحتاجه في مكان واحد
        </h2>

        <p class="muted">
            أدوات ذكية مصممة لتجعل يومك أسهل.
        </p>

    </div>


    <div class="cards">

        <div class="card">

            <div class="icon">
                💬
            </div>

            <h3>
                محادثة ذكية
            </h3>

            <p>
                تحدث مع Aivora واحصل على إجابات
                وأفكار واضحة وسريعة.
            </p>

        </div>


        <div class="card">

            <div class="icon">
                ✍️
            </div>

            <h3>
                كتابة المحتوى
            </h3>

            <p>
                أنشئ النصوص والأفكار والمسودات
                بأسلوب احترافي.
            </p>

        </div>


        <div class="card">

            <div class="icon">
                🚀
            </div>

            <h3>
                إنتاجية أعلى
            </h3>

            <p>
                اختصر الوقت ونظّم أفكارك
                وأنجز مهامك بسهولة.
            </p>

        </div>

    </div>

</section>


<!-- المحادثة -->

<section id="chat">

    <div class="center">

        <h2 class="section-title">
            جرّب المحادثة
        </h2>

        <p class="muted">
            واجهة تجريبية لـ Aivora
        </p>

    </div>


    <div class="chat">

        <div class="message ai">

            مرحبًا! أنا Aivora 🤖
            كيف يمكنني مساعدتك اليوم؟

        </div>


        <div class="message user">

            أعطني فكرة لمشروع جديد.

        </div>


        <div class="message ai">

            بكل سرور!
            أخبرني باهتماماتك وسأقترح عليك
            أفكارًا مناسبة.

        </div>


        <div class="chat-input">

            <div class="input-box">
                اكتب رسالتك هنا...
            </div>

            <button class="button"
            onclick="alert('هذه نسخة الواجهة التجريبية. سيتم ربط الذكاء الاصطناعي لاحقًا.')">
                إرسال
            </button>

        </div>

    </div>

</section>


<!-- عن Aivora -->

<section id="about">

    <div class="cta">

        <h2>
            جاهز لتجربة Aivora؟
        </h2>

        <p class="muted">
            ابدأ رحلتك مع مساعدك الذكي.
        </p>

        <br>

        <button class="button"
        onclick="document.getElementById('chat').scrollIntoView({behavior:'smooth'})">
            ابدأ الآن ✨
        </button>

    </div>

</section>

</main>


<!-- التذييل -->

<footer class="container footer">

    <div>
        © 2026 Aivora — جميع الحقوق محفوظة
    </div>

    <div>
        ذكاء اصطناعي من أجل الجميع
    </div>

</footer>


</body>
</html>
