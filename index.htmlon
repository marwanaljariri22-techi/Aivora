<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>AIVORA — الذكاء الاصطناعي المتطور</title>

<style>
*{box-sizing:border-box}

html,body{
margin:0;
min-height:100%;
font-family:Tahoma,Arial,sans-serif;
background:#020613;
color:#fff;
}

body{
overflow-x:hidden;
background:
radial-gradient(circle at 10% 35%,rgba(90,40,220,.28),transparent 30%),
radial-gradient(circle at 60% 20%,rgba(30,90,255,.12),transparent 32%),
linear-gradient(135deg,#020613,#071127 55%,#020613);
}

button,input,textarea{
font:inherit;
}

button{
cursor:pointer;
}

.top{
height:86px;
display:flex;
align-items:center;
justify-content:space-between;
padding:0 32px;
border-bottom:1px solid rgba(150,130,255,.16);
}

.actions{
display:flex;
gap:14px;
align-items:center;
}

.btn{
border:1px solid #2a3150;
background:#0b1328;
color:#fff;
padding:13px 22px;
border-radius:14px;
}

.primary{
background:linear-gradient(135deg,#762cff,#3920cc);
border-color:#9b6cff;
box-shadow:0 0 25px rgba(110,50,255,.3);
}

.lang{
padding:12px 18px;
border:1px solid #28304d;
border-radius:14px;
background:#0b1328;
color:#fff;
}

.layout{
display:grid;
grid-template-columns:1fr 350px;
direction:ltr;
min-height:calc(100vh - 86px);
}

.main{
direction:rtl;
padding:28px 5vw 24px;
position:relative;
}

.sidebar{
direction:rtl;
border-left:1px solid rgba(150,130,255,.18);
padding:25px 18px;
background:rgba(4,10,27,.76);
}

.brand{
text-align:center;
margin:5px 0 8px;
font-weight:900;
font-size:76px;
letter-spacing:6px;
background:linear-gradient(90deg,#9f5cff,#e6d5ff,#6a91ff);
-webkit-background-clip:text;
color:transparent;
text-shadow:0 0 30px rgba(137,70,255,.25);
}

.logoA{
font-size:82px;
display:inline-block;
margin-left:10px;
color:#8e55ff;
text-shadow:0 0 28px #5e25ff;
}

.tag{
text-align:center;
font-size:20px;
color:#ddd;
margin-bottom:16px;
}

.welcome{
text-align:center;
font-size:38px;
margin:0 0 8px;
}

.welcome span{
color:#a06aff;
}

.sub{
text-align:center;
color:#b8bed0;
font-size:18px;
margin:0 0 25px;
}

.pills{
display:flex;
justify-content:center;
gap:18px;
flex-wrap:wrap;
margin-bottom:18px;
}

.pill{
border:1px solid #242e4b;
background:#091329;
padding:10px 20px;
border-radius:30px;
color:#d8dced;
}

.chat{
max-width:1000px;
margin:auto;
border:1px solid #7251d5;
border-radius:22px;
background:rgba(11,21,47,.78);
box-shadow:0 0 35px rgba(90,40,220,.18);
padding:24px;
}

.chat textarea{
width:100%;
height:100px;
resize:none;
background:transparent;
border:0;
outline:0;
color:#fff;
font-size:18px;
text-align:right;
}

.chatbar{
display:flex;
justify-content:space-between;
align-items:center;
}

.send{
width:58px;
height:58px;
border-radius:50%;
border:0;
background:linear-gradient(135deg,#7c28ff,#3e2ee0);
color:white;
font-size:25px;
}

.tools{
display:flex;
gap:10px;
}

.tool{
padding:11px 18px;
border:1px solid #394363;
background:#0d1730;
border-radius:12px;
color:#fff;
}

.privacy{
text-align:center;
color:#aeb6c9;
margin:16px;
}

.cards{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:20px;
max-width:1080px;
margin:20px auto;
}

.card{
min-height:170px;
padding:22px;
border:1px solid #273250;
background:linear-gradient(145deg,rgba(14,25,52,.9),rgba(5,13,30,.9));
border-radius:20px;
text-align:center;
}

.icon{
font-size:38px;
margin-bottom:12px;
}

.card h3{
margin:5px 0 12px;
font-size:20px;
}

.card p{
margin:0;
color:#aeb6ca;
line-height:1.8;
}

.stats{
max-width:1080px;
margin:20px auto;
border:1px solid #26304c;
border-radius:20px;
padding:20px;
display:grid;
grid-template-columns:repeat(4,1fr);
background:rgba(6,15,33,.72);
}

.stat{
text-align:center;
border-left:1px solid #28324d;
}

.stat:last-child{
border-left:0;
}

.num{
font-size:25px;
font-weight:bold;
color:#a46aff;
}

.small{
color:#b7bed0;
margin-top:6px;
}

.sidebrand{
text-align:center;
font-size:32px;
font-weight:900;
letter-spacing:3px;
background:linear-gradient(90deg,#a75dff,#6a9dff);
-webkit-background-clip:text;
color:transparent;
}

.sideTag{
text-align:center;
color:#aeb5c9;
margin-bottom:25px;
}

.menu{
display:grid;
gap:8px;
}

.menu button{
width:100%;
text-align:right;
padding:15px 18px;
border:0;
background:transparent;
color:#e9eaf3;
border-radius:14px;
font-size:17px;
}

.menu button:hover,
.menu .active{
background:linear-gradient(90deg,#5120c7,#2b176c);
box-shadow:0 0 18px rgba(104,43,255,.25);
}

.divider{
height:1px;
background:#252e48;
margin:18px 4px;
}

.profile{
margin-top:24px;
padding:18px;
border:1px solid #2b3553;
border-radius:18px;
background:#080f24;
text-align:center;
}

.avatar{
width:64px;
height:64px;
border-radius:50%;
display:grid;
place-items:center;
margin:0 auto 10px;
background:linear-gradient(135deg,#7b27ff,#3024a8);
font-size:27px;
}

.profile strong{
display:block;
color:#ad70ff;
font-size:18px;
}

.profile small{
color:#b8bed0;
}

footer{
text-align:center;
color:#8f96aa;
padding:10px 0 0;
}

@media(max-width:950px){

.layout{
grid-template-columns:1fr;
}

.sidebar{
grid-row:1;
border-left:0;
border-bottom:1px solid #1d2741;
}

.main{
padding:25px 18px;
}

.brand{
font-size:48px;
}

.logoA{
font-size:55px;
}

.welcome{
font-size:29px;
}

.cards{
grid-template-columns:1fr 1fr;
}

.stats{
grid-template-columns:1fr 1fr;
gap:18px;
}

.stat{
border-left:0;
}

}

@media(max-width:600px){

.top{
padding:0 14px;
height:auto;
min-height:76px;
}

.actions .btn{
padding:10px 12px;
}

.lang{
padding:10px;
}

.brand{
font-size:34px;
}

.logoA{
font-size:40px;
}

.cards,
.stats{
grid-template-columns:1fr;
}

.chat{
padding:15px;
}

.cards{
gap:12px;
}

}
</style>
</head>

<body>

<header class="top">

<div class="actions">

<button class="btn">
تسجيل الدخول
</button>

<button class="btn primary">
إنشاء حساب ✦
</button>

<button class="btn" onclick="toggleTheme()">
☾
</button>

</div>

<button class="lang">
🌐 العربية ▾
</button>

</header>


<div class="layout">


<main class="main">


<div class="brand">
<span class="logoA">A</span>AIVORA
</div>

<div class="tag">
الذكاء الاصطناعي المتطور
</div>


<h1 class="welcome">
مرحباً بك في <span>Aivora</span>
</h1>

<p class="sub">
مساعدك الذكي للإجابة على الأسئلة، الكتابة، البرمجة، الترجمة والمزيد
</p>


<div class="pills">

<div class="pill">
✦ ذكي ومتطور
</div>

<div class="pill">
⚡ سريع ودقيق
</div>

<div class="pill">
🌐 يدعم العربية
</div>

<div class="pill">
◷ متاح دائماً
</div>

</div>


<section class="chat">

<textarea
id="msg"
placeholder="اكتب رسالتك هنا..."
></textarea>

<div class="chatbar">

<button
class="send"
onclick="sendMsg()"
>
➤
</button>

<div class="tools">

<button class="tool">
✦ أدوات
</button>

<button class="tool">
📎 إرفاق ملف
</button>

</div>

</div>

</section>


<div class="privacy">
🛡 خصوصيتك وأمان بياناتك هي أولويتنا
</div>


<section class="cards">


<article class="card">

<div class="icon">
🌐
</div>

<h3>
الترجمة واللغات
</h3>

<p>
ترجمة النصوص بين عدة لغات بدقة عالية
</p>

</article>


<article class="card">

<div class="icon">
📖
</div>

<h3>
التعلم والبحث
</h3>

<p>
شرح المفاهيم، تلخيص النصوص والبحث في المعلومات
</p>

</article>


<article class="card">

<div class="icon">
⌘
</div>

<h3>
البرمجة
</h3>

<p>
مساعدتك في كتابة الأكواد وحل المشكلات البرمجية
</p>

</article>


<article class="card">

<div class="icon">
✎
</div>

<h3>
الكتابة والمحتوى
</h3>

<p>
إنشاء المقالات والقصص والمحتوى التسويقي باحترافية
</p>

</article>


</section>


<section class="stats">


<div class="stat">

<div class="num">
+10K
</div>

<div class="small">
مستخدم سعيد
</div>

</div>


<div class="stat">

<div class="num">
+50K
</div>

<div class="small">
محادثة تمت
</div>

</div>


<div class="stat">

<div class="num">
+99.9%
</div>

<div class="small">
وقت تشغيل
</div>

</div>


<div class="stat">

<div class="num">
100%
</div>

<div class="small">
خصوصية وأمان
</div>

</div>


</section>


<footer>
© 2026 Aivora — جميع الحقوق محفوظة. 💜
</footer>


</main>


<aside class="sidebar">


<div class="sidebrand">
AIVORA
</div>

<div class="sideTag">
الذكاء الاصطناعي المتطور
</div>


<nav class="menu">


<button
class="active"
onclick="activate(this)"
>
⌂ الرئيسية
</button>


<button
onclick="activate(this)"
>
▢ المحادثات
</button>


<button
onclick="activate(this)"
>
☆ المفضلة
</button>


<button
onclick="activate(this)"
>
▤ المستندات
</button>


<button
onclick="activate(this)"
>
◇ الأدوات
</button>


<button
onclick="activate(this)"
>
文 الترجمة
</button>


<button
onclick="activate(this)"
>
⚙ الإعدادات
</button>


</nav>


<div class="divider">
</div>


<nav class="menu">

<button>
ⓘ حول Aivora
</button>

<button>
♧ تواصل معنا
</button>

</nav>


<div class="profile">

<div class="avatar">
M
</div>

<strong>
Marwan Aljariri
</strong>

<small>
👑 مؤسس Aivora
</small>

</div>


</aside>

</div>


<script>

function activate(el){

document
.querySelectorAll('.menu button')
.forEach(function(b){

b.classList.remove('active');

});

el.classList.add('active');

}


function sendMsg(){

const t=document.getElementById('msg');

if(t.value.trim()){

alert(
'تم استلام رسالتك في Aivora: '+t.value
);

t.value='';

}

}


function toggleTheme(){

document.body.classList.toggle('light');

}

</script>


</body>
</html>
