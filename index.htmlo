<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Aivora AI</title>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,Tahoma,sans-serif;background:#0b1020;color:#fff;min-height:100vh}
header{padding:28px 20px;text-align:center;background:linear-gradient(135deg,#111936,#172554)}
.logo{font-size:42px;font-weight:800;letter-spacing:1px}
.logo span{color:#60a5fa}
.tag{color:#cbd5e1;margin-top:8px;font-size:16px}
main{max-width:900px;margin:35px auto;padding:0 18px}
.card{background:#111827;border:1px solid #26324a;border-radius:22px;padding:22px;box-shadow:0 15px 40px #0005}
h2{margin-top:0}
textarea{width:100%;min-height:150px;border-radius:15px;border:1px solid #334155;background:#0f172a;color:#fff;padding:16px;font-size:17px;resize:vertical;outline:none}
button{margin-top:14px;width:100%;padding:15px;border:0;border-radius:14px;background:#3b82f6;color:white;font-size:17px;font-weight:bold;cursor:pointer}
button:hover{background:#2563eb}
#answer{margin-top:20px;padding:18px;border-radius:15px;background:#0f172a;border:1px solid #334155;min-height:70px;line-height:1.8;color:#e2e8f0}
footer{text-align:center;color:#94a3b8;padding:30px 15px}
.small{font-size:13px;color:#94a3b8;margin-top:10px}
</style>
</head>
<body>
<header>
  <div class="logo">Ai<span>vora</span></div>
  <div class="tag">مساعدك الذكي — سريع، بسيط، وعالمي</div>
</header>

<main>
  <div class="card">
    <h2>اسأل Aivora</h2>
    <textarea id="question" placeholder="اكتب سؤالك هنا..."></textarea>
    <button onclick="askAivora()">إرسال السؤال</button>
    <div id="answer">ستظهر الإجابة هنا.</div>
    <div class="small">نسخة واجهة تجريبية — يمكن ربطها لاحقًا بواجهة ذكاء اصطناعي حقيقية.</div>
  </div>
</main>

<footer>
  © 2026 Aivora — جميع الحقوق محفوظة
</footer>

<script>
function askAivora(){
  const q=document.getElementById("question").value.trim();
  const a=document.getElementById("answer");
  if(!q){a.textContent="اكتب سؤالك أولاً.";return;}
  a.textContent="تم استلام سؤالك: «"+q+"» — هذه واجهة Aivora التجريبية. لعرض إجابات الذكاء الاصطناعي الفعلية نحتاج ربط الموقع بخدمة API.";
}
</script>
</body>
</html>
